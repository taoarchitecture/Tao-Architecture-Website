# Server Configuration
PORT=5000
NODE_ENV=development

# Database
# Neon PostgreSQL Configuration
# DATABASE_URL: Use the Pooled connection string (Transaction Mode)
# DIRECT_URL: Use the Direct connection string (Session Mode) - Required for migrations
DATABASE_URL="postgres://user:password@ep-host.region.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgres://user:password@ep-host.region.neon.tech/neondb?sslmode=require&connect_timeout=0"

# YouTube API
# Get this from Google Cloud Console
YOUTUBE_API_KEY=your_youtube_api_key
YOUTUBE_CHANNEL_HANDLE=@TAOSTUDIO_0

# JWT Secret for Authentication
JWT_SECRET=your_super_secret_jwt_key
# Keep disabled in production unless performing a controlled admin bootstrap.
ALLOW_ADMIN_REGISTRATION=false

# Cloudinary (File Uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Vercel Observability
# Required for custom admin Web Analytics queries.
VERCEL_ACCESS_TOKEN=your_vercel_access_token
VERCEL_PROJECT_ID=prj_xxxxxxxxxxxxxxxxxxxx
# Optional for team-owned projects. Provide either TEAM_ID or TEAM_SLUG.
VERCEL_TEAM_ID=team_xxxxxxxxxxxxxxxxxxxx
VERCEL_TEAM_SLUG=your-team-slug

# Email (Nodemailer)
# Example for Gmail / SMTP
SMTP_HOST=smtp.gmail.com
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
